# Copy to project_service/.env. Never publish a completed .env.
PROJECT_HOST=0.0.0.0
PROJECT_PORT=9910
# Long random key used ONLY between Dify and this project service (>=24 chars).
PROJECT_API_KEY=
# Separate random key for signed confirmation forms/download links (>=32 chars).
PROJECT_SIGNING_KEY=
# Base URL reachable from users' browsers. No trailing slash.
PROJECT_PUBLIC_BASE_URL=
# Optional absolute storage path; default is project_service/project_data.
# PROJECT_DATA_DIR=/absolute/path/cabinet_project_data
COMMAND_WAIT_SECONDS=45
MAX_PDF_PAGES=20
MAX_UPLOAD_MB=32

# Existing product query API. This service NEVER writes MongoDB.
PRODUCT_QUERY_API_BASE_URL=
PRODUCT_QUERY_API_KEY=

# Qwen visual model, OpenAI-compatible API base INCLUDING /v1 if required.
# Example format: https://your-model-service/compatible-mode/v1
VISION_API_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=120
VISION_MAX_TOKENS=8192

# Optional until a real converter is installed. Full /convert endpoint URL.
CAD_CONVERT_URL=
CAD_CONVERT_API_KEY=
QUOTE_MARKUP_RATE=0.15
QUOTE_DISCOUNT_RATE=0
