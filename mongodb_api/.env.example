# Copy to .env on the deployment server. Never commit the real .env.
# Use an already-existing Dify Docker network shared with the HTTP caller/proxy.
DIFY_NETWORK=docker_default
MONGODB_URI='mongodb://match_agent_api:CHANGE_THIS_PASSWORD@MONGO_SERVER_IP:27017/?authSource=admin'
MONGODB_DB=match_agent
MONGODB_API_KEY='replace-with-a-long-random-key'
