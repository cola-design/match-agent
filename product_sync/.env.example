# This is a separate WRITER account. Never reuse the public-facing API's read-only account.
SYNC_MONGODB_URI='mongodb://match_agent_sync:CHANGE_THIS_PASSWORD@MONGODB_IP:27017/?authSource=admin'
MONGODB_DB=match_agent
PRODUCT_API_URL='http://api2.tengen.com.cn/env-101/otherportal/otherproject/ai/getProductSpec'
PRODUCT_API_KEY='CHANGE_THIS_SOURCE_API_KEY'
# Must cover the FULL product/attribute history, confirmed with the source owner.
SOURCE_DATE_FROM='2017-01-01'
SOURCE_PAGE_SIZE=1000
SOURCE_REQUEST_INTERVAL_SECONDS=0.2
# Stop before writes when a truncated snapshot or unexpectedly large change is detected.
MIN_SOURCE_PRODUCTS=116632
MIN_COVERAGE_RATIO=0.9
MAX_CHANGE_RATIO=0.2
